# Relative paths resolve against the project root, not the shell's working directory; ~ is expanded.
# A blank value means the default, and each default is the value written here.
# Keep comments on their own lines: when a value is empty, dotenv takes an inline comment as the value itself.

# Hotkey in pynput syntax, e.g. <ctrl>+h, <ctrl>+<shift>+d, <f13>. The trigger key is swallowed; the focused app never sees it.
# On macOS the trigger key is matched by the character it types: Option, or Shift with a non-letter key, changes that
# character and the trigger is no longer recognized.
DICTATION_HOTKEY=<ctrl>+h

# hold: hold to talk, release to transcribe. toggle: press once to start recording, press again to transcribe.
DICTATION_MODE=hold

# Blank: detect the language per utterance, so mixed languages need no switching. Occasionally a whole utterance is taken
# as another language, and part of it is translated into that language or dropped.
# Chinese: English and Japanese still come out as spoken, and Chinese followed by English keeps both (tested with
# synthetic speech). Use full English language names such as Chinese, English, Japanese; codes like zh are not mapped.
DICTATION_LANGUAGE=

# Vocabulary file: one term per line, anything after # is a comment; joined into the system prompt. Read on every
# hotkey press. The longer the list, the more likely the model writes terms that were never said.
DICTATION_VOCAB=vocab.txt

# Base URL of the llama-server serving Qwen3-ASR. At startup dictation waits until its /health answers.
DICTATION_SERVER=http://127.0.0.1:8080

# Maximum tokens generated per utterance (max_tokens in the request); anything beyond is cut off.
DICTATION_MAX_NEW_TOKENS=512

# Seconds to wait for one transcription request before it counts as failed (logged, and a notice is pasted).
DICTATION_TIMEOUT_SEC=60

# Seconds between writing the clipboard and sending the paste keystroke. Clipboard-history listeners briefly hold the
# clipboard after an update; too short and the paste occasionally comes out empty.
DICTATION_PASTE_DELAY_SEC=0.05

# Seconds between the paste keystroke and restoring the clipboard. Target apps read the clipboard asynchronously;
# too short and the old content gets pasted.
DICTATION_RESTORE_DELAY_SEC=0.5

# Where output and errors go when there is no console (the pythonw scheduled task).
DICTATION_LOG_FILE=~/.local/state/dictation/dictation.log
